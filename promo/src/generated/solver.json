size: A4; }\n                }\n            </style>\n        </head>\n        <body>\n            <h2>24 Point Game History (All)</h2>\n            <div class=\"print-container\">\n                \n                    <div class=\"print-card\">\n                        <div class=\"header\">\n                            <span>Round 1</span>\n                            <span class=\"win\">WIN</span>\n                        </div>\n                        <div class=\"nums-row\">\n                            <div class=\"num-box\">3</div><div class=\"num-box\">8</div><div class=\"num-box\">3</div><div class=\"num-box\">8</div>\n                        </div>\n                        <div class=\"solutions\">\n                            <div><strong>Ref Solution:</strong></div>\n                            <div>• 8 / (3 - 8 / 3)</div>\n                        </div>\n                    </div>\n                \n                    <div class=\"print-card\">\n                        <div class=\"header\">\n                            <span>Round 2</span>\n                            <span class=\"win\">WIN</span>\n                        </div>\n                        <div class=\"nums-row\">\n                            <div class=\"num-box\">6</div><div class=\"num-box\">2</div><div class=\"num-box\">1</div><div class=\"num-box\">3</div>\n                        </div>\n                        <div class=\"solutions\">\n                            <div><strong>Ref Solution:</strong></div>\n                            <div>• (6 + 2) * 1 * 3</div><div>• (6 + 2) / 1 * 3</div><div>• 6 * 2 * (3 - 1)</div>\n                        </div>\n                    </div>\n                \n                    <div class=\"print-card\">\n                        <div class=\"header\">\n                            <span>Round 3</span>\n                            <span class=\"win\">WIN</span>\n                        </div>\n                        <div class=\"nums-row\">\n